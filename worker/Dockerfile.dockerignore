# Minimal build context: exclude everything, then re-include only what the
# worker image COPYs. Keeps node_modules/.next/.git out of the daemon context.
*
!worker/requirements.txt
!worker/entrypoint.py
!scripts/*.py
!scripts/requirements.txt
!docs/specs/schemas/*.json
# scripts/validate_store.py reads this one at import, so prepare.py cannot
# start without it (docs/specs/conventions.md)
!docs/specs/conventions.json
