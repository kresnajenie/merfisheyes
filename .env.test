# Environment for the @upload E2E suite (docker-compose.test.yml).
# Loaded automatically by playwright.config.ts when E2E_UPLOAD=1.
# Safe to commit: these are local-only test credentials for ephemeral services.

# Postgres (mapped to host port 5433 to avoid clashing with a local dev DB).
DATABASE_URL="postgresql://merfish:merfish@localhost:5433/merfisheyes_test"
DIRECT_URL="postgresql://merfish:merfish@localhost:5433/merfisheyes_test"

# MinIO (S3-compatible).
AWS_S3_ENDPOINT="http://localhost:9000"
AWS_REGION="us-east-1"
AWS_S3_BUCKET="merfisheyes-test"
AWS_ACCESS_KEY_ID="minioadmin"
AWS_SECRET_ACCESS_KEY="minioadmin"

# App
NEXT_PUBLIC_E2E="1"
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
