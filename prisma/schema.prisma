generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Auth (NextAuth v5) ─────────────────────────────────────────

enum UserRole {
  USER
  ADMIN
  SUPER_ADMIN
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime? @map("email_verified")
  image         String?
  role          UserRole  @default(USER)
  computeTier   String    @default("standard") @map("compute_tier")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  accounts        Account[]
  sessions        Session[]
  catalogDatasets CatalogDataset[]
  datasets        Dataset[]
  projects        Project[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// Throttles the email sign-in code flow. Needs to be shared state, not
// in-process: on serverless every request may hit a different instance, so an
// in-memory counter is trivially bypassed by spreading requests around.
//
// A wrong code does NOT consume its verification token (the adapter only
// deletes on a successful lookup), so without this a 6-digit code can be
// guessed indefinitely inside its validity window.
model LoginAttempt {
  id         String   @id @default(cuid())
  identifier String // email, normalized to lowercase
  kind       String // "issue" | "verify_fail"
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([identifier, kind, createdAt])
  @@map("login_attempts")
}

// ─── Catalog ────────────────────────────────────────────────────

model CatalogDataset {
  id           String  @id @default(cuid())

  // Display metadata
  title        String  @db.VarChar(500)
  description  String? @db.Text
  species      String? @db.VarChar(200)
  disease      String? @db.VarChar(200)
  institute    String? @db.VarChar(500)
  tissue       String? @db.VarChar(200)
  platform     String? @db.VarChar(200)
  tags         String[] @default([])
  genes        String[] @default([])
  thumbnailUrl String? @map("thumbnail_url") @db.VarChar(1000)

  // BIL identifier (e.g., "ace-dip-use")
  bilCode      String? @unique @map("bil_code") @db.VarChar(50)

  // Dynamic metadata (investigator, institution, funding, etc.)
  metadata     Json?   @default("{}")

  // Original source link (BIL page, publication, data repository)
  externalLink    String? @map("external_link") @db.VarChar(1000)
  publicationLink String? @map("publication_link") @db.VarChar(1000)

  // Sub-entries (each links to a viewer dataset)
  entries      CatalogDatasetEntry[]

  // Publishing
  isPublished  Boolean @default(false) @map("is_published")
  isFeatured   Boolean @default(false) @map("is_featured")
  isBil        Boolean @default(false) @map("is_bil")
  isInternal   Boolean @default(false) @map("is_internal")
  sortOrder    Int     @default(0) @map("sort_order")

  // Community submissions: user-submitted catalog rows that go through admin
  // review. Curated (admin-authored) rows keep isCommunity=false and the
  // default APPROVED status, so existing behavior is unchanged. Community rows
  // only surface on Explore's Community tab, and only once APPROVED + published.
  isCommunity     Boolean             @default(false) @map("is_community")
  reviewStatus    CatalogReviewStatus @default(APPROVED) @map("review_status")
  reviewNote      String?             @map("review_note") @db.Text
  submittedById   String?             @map("submitted_by")
  // Soft links back to the owned source the submission was generated from, so a
  // re-submit updates this same row and the owner can track its review status.
  sourceDatasetId String?             @map("source_dataset_id") @db.VarChar(50)
  sourceProjectId String?             @map("source_project_id")

  // Stats (manually entered)
  numCells     Int?    @map("num_cells")
  numGenes     Int?    @map("num_genes")

  // Audit
  createdBy     String?   @map("created_by")
  createdByUser User?     @relation(fields: [createdBy], references: [id], onDelete: SetNull)
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@index([isPublished])
  @@index([isFeatured])
  @@index([isBil])
  @@index([isInternal])
  @@index([sortOrder])
  @@index([bilCode])
  @@index([isCommunity])
  @@index([reviewStatus])
  @@index([submittedById])
  @@index([sourceDatasetId])
  @@index([sourceProjectId])
  @@map("catalog_datasets")
}

model CatalogDatasetEntry {
  id            String  @id @default(cuid())
  catalogId     String  @map("catalog_id")
  label         String  @db.VarChar(200)
  datasetType   String  @map("dataset_type") @db.VarChar(50)
  s3BaseUrl     String? @map("s3_base_url") @db.VarChar(1000)
  datasetId     String? @map("dataset_id") @db.VarChar(50)
  thumbnailUrl  String? @map("thumbnail_url") @db.VarChar(1000)
  sortOrder     Int     @default(0) @map("sort_order")

  catalog      CatalogDataset @relation(fields: [catalogId], references: [id], onDelete: Cascade)

  @@index([catalogId])
  @@map("catalog_dataset_entries")
}

enum CatalogReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

// ─── Projects (user-owned folders of datasets) ─────────────────────

// A named folder grouping several of a user's datasets, with its own
// catalog-style metadata. Can be submitted to Explore as one Community card
// (its member datasets become the catalog entries).
model Project {
  id              String   @id @default(cuid())
  title           String   @db.VarChar(500)
  description     String?  @db.Text
  species         String?  @db.VarChar(200)
  disease         String?  @db.VarChar(200)
  tissue          String?  @db.VarChar(200)
  platform        String?  @db.VarChar(200)
  institute       String?  @db.VarChar(500)
  tags            String[] @default([])
  thumbnailUrl    String?  @map("thumbnail_url") @db.VarChar(1000)
  externalLink    String?  @map("external_link") @db.VarChar(1000)
  publicationLink String?  @map("publication_link") @db.VarChar(1000)
  // Flexible display metadata bag (investigator, institution, age, authors,
  // citation, funding, sex, genotype, technique, publicationYear, license…),
  // mirroring CatalogDataset.metadata. Carried into the catalog on submit and
  // rendered on the Explore detail page.
  metadata        Json?    @default("{}")

  ownerId   String   @map("owner_id")
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  datasets  ProjectDataset[]
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([ownerId])
  @@map("projects")
}

// Join table: a dataset can belong to many projects (flexible membership).
model ProjectDataset {
  projectId String   @map("project_id")
  datasetId String   @map("dataset_id") @db.VarChar(50)
  sortOrder Int      @default(0) @map("sort_order")
  addedAt   DateTime @default(now()) @map("added_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  dataset Dataset @relation(fields: [datasetId], references: [id], onDelete: Cascade)

  @@id([projectId, datasetId])
  @@index([datasetId])
  @@map("project_datasets")
}

// ─── Dataset Upload (existing) ──────────────────────────────────

model Dataset {
  id             String          @id @db.VarChar(50)
  fingerprint    String          @unique @db.VarChar(64)
  title          String?         @db.VarChar(500)
  numCells       Int             @map("num_cells")
  numGenes       Int             @map("num_genes")
  // Gene symbols in this dataset, for gene search over a user's uploads (and,
  // via community submission, over Explore). Filled server-side when
  // processing completes — from the S3 expr index (single cell) or the
  // manifest (single molecule) — and backfillable for older rows via
  // scripts/backfill-dataset-genes.ts. Searched through the same trgm index
  // pattern as CatalogDataset.genes.
  genes          String[]        @default([])
  datasetType    String?         @map("dataset_type") @db.VarChar(50)
  formatVersion  String          @default("chunked") @map("format_version") @db.VarChar(20)
  manifestJson   Json?           @map("manifest_json")
  status         DatasetStatus   @default(UPLOADING)
  manifestUrl    String?         @map("manifest_url") @db.VarChar(1000)
  errorMessage   String?         @map("error_message")
  // Whose fault a FAILED processing run was. Auto-set from the error text on
  // failure (see lib/ingest/error-classification.ts); an admin can override it
  // from the processing dashboard.
  faultCategory  DatasetFaultCategory? @map("fault_category")
  ownerId            String? @map("owner_id")
  ingestSource       String? @map("ingest_source")
  batchJobId         String? @map("batch_job_id")
  processingParams   Json?   @map("processing_params")
  processingProgress Json?   @map("processing_progress")
  // Normalized S3 base URL for datasets registered from a raw S3 link.
  // Unique so re-registering the same URL dedups to one row.
  s3BaseUrl      String?         @unique @map("s3_base_url") @db.VarChar(1000)
  // Owner-saved viewer defaults (rotation, flips, priority column, per-sample
  // transforms, color overrides). See lib/utils/viewer-config.ts.
  viewerConfig   Json?           @map("viewer_config")
  // Owner-set thumbnail (a screenshot of the scene). Served via the app's
  // /api/datasets/[id]/thumbnail proxy route.
  thumbnailUrl   String?         @map("thumbnail_url") @db.VarChar(1000)
  // Owner-editable catalog-style metadata. Independent of publishing — the
  // owner can fill these in any time; they're carried into a CatalogDataset
  // when the dataset is submitted to Explore. Mirrors CatalogDataset fields.
  description    String?         @db.Text
  species        String?         @db.VarChar(200)
  disease        String?         @db.VarChar(200)
  tissue         String?         @db.VarChar(200)
  platform       String?         @db.VarChar(200)
  institute      String?         @db.VarChar(500)
  tags           String[]        @default([])
  externalLink   String?         @map("external_link") @db.VarChar(1000)
  publicationLink String?        @map("publication_link") @db.VarChar(1000)
  // Flexible display metadata bag (investigator, institution, age, authors,
  // citation, …), mirroring CatalogDataset.metadata. Carried into the catalog
  // on submit and rendered on the Explore detail page.
  metadata       Json?           @default("{}")
  // Denormalized cache of the deduped view count (source of truth: dataset_views).
  viewCount      Int             @default(0) @map("view_count")
  // Owned by "admin" collectively: any admin can edit, and it's not tied to a
  // personal account. Distinct from an admin personally owning a dataset
  // (adminOwned=false, ownerId=that admin), which is NOT shared.
  adminOwned     Boolean         @default(false) @map("admin_owned")
  createdAt      DateTime        @default(now()) @map("created_at")
  completedAt    DateTime?       @map("completed_at")
  owner          User?           @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  uploadSessions UploadSession[]
  views          DatasetView[]
  viewDaily      DatasetViewDaily[]
  projects       ProjectDataset[]

  @@index([fingerprint])
  @@index([status])
  @@index([createdAt(sort: Desc)])
  @@index([datasetType])
  @@index([ownerId])
  @@index([s3BaseUrl])
  @@map("datasets")
}

// One row per (dataset, viewer session, UTC day) — the dedup guard for view
// counting. sessionKey is the signed-in user id, else an anon cookie id.
model DatasetView {
  id         String   @id @default(cuid())
  datasetId  String   @map("dataset_id") @db.VarChar(50)
  sessionKey String   @map("session_key")
  day        DateTime @db.Date
  userId     String?  @map("user_id")
  createdAt  DateTime @default(now()) @map("created_at")
  dataset    Dataset  @relation(fields: [datasetId], references: [id], onDelete: Cascade)

  @@unique([datasetId, sessionKey, day])
  @@index([datasetId, day])
  @@map("dataset_views")
}

// Per-day view rollup for cheap trend queries (Phase 2 dashboard/notifications).
model DatasetViewDaily {
  datasetId String   @map("dataset_id") @db.VarChar(50)
  day       DateTime @db.Date
  count     Int      @default(0)
  dataset   Dataset  @relation(fields: [datasetId], references: [id], onDelete: Cascade)

  @@id([datasetId, day])
  @@index([day])
  @@map("dataset_views_daily")
}

model UploadSession {
  id             String       @id @db.VarChar(50)
  datasetId      String       @map("dataset_id") @db.VarChar(50)
  totalFiles     Int          @map("total_files")
  completedFiles Int          @default(0) @map("completed_files")
  expiresAt      DateTime     @map("expires_at")
  createdAt      DateTime     @default(now()) @map("created_at")
  files          UploadFile[]
  dataset        Dataset      @relation(fields: [datasetId], references: [id], onDelete: Cascade)

  @@index([datasetId])
  @@index([expiresAt])
  @@map("upload_sessions")
}

model UploadFile {
  id              String        @id @default(uuid()) @db.Uuid
  uploadSessionId String        @map("upload_session_id") @db.VarChar(50)
  fileKey         String        @map("file_key") @db.VarChar(500)
  fileSize        BigInt?       @map("file_size")
  status          FileStatus    @default(PENDING)
  uploadedAt      DateTime?     @map("uploaded_at")
  errorMessage    String?       @map("error_message")
  uploadSession   UploadSession @relation(fields: [uploadSessionId], references: [id], onDelete: Cascade)

  @@unique([uploadSessionId, fileKey])
  @@index([uploadSessionId])
  @@index([status])
  @@map("upload_files")
}

enum DatasetStatus {
  UPLOADING
  QUEUED
  PROCESSING
  COMPLETE
  FAILED
}

// Whose fault a processing failure was. USER = something about the uploaded
// data (bad format, missing columns, …); PLATFORM = our side (timeout, OOM,
// lost/expired job, no output); UNKNOWN = couldn't be auto-classified.
enum DatasetFaultCategory {
  USER
  PLATFORM
  UNKNOWN
}

enum FileStatus {
  PENDING
  UPLOADING
  COMPLETE
  FAILED
}
